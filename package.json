{
  "name": "treasy",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "node node_modules/expo/bin/cli start",
    "android": "node node_modules/expo/bin/cli start --android",
    "ios": "node node_modules/expo/bin/cli start --ios",
    "web": "node node_modules/expo/bin/cli start --web",
    "build:web": "expo export --platform web && node scripts/postexport-web.js",
    "build": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "verify:architecture": "node scripts/verify-architecture.js",
    "verify": "npm run typecheck && npm run verify:architecture"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.1.26",
    "@supabase/auth-js": "^2.104.1",
    "babel-preset-expo": "~54.0.9",
    "expo": "~54.0.31",
    "expo-status-bar": "^3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@types/react-native": "^0.72.8",
    "babel-preset-expo": "^54.0.8",
    "typescript": "~5.9.2"
  }
}
